<Application x:Class="ModernCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Orange" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- Calculator Themes -->
                <ResourceDictionary Source="Resources/Themes/CalculatorTheme.xaml"/>
                <ResourceDictionary Source="Resources/Themes/DarkTheme.xaml"/>

                <!-- Custom Styles -->
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Resources/Styles/DisplayStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Resources -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#212121"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#757575"/>
            <SolidColorBrush x:Key="CalculatorBackgroundBrush" Color="#FAFAFA"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>